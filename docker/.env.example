# 复制到 docker/.env，填写独立的 API 与 Web 管理密钥。
API_KEY=
WEB_PASSWORD=
# release compose 必填；从通过 CI 的镜像发布记录获取完整 sha256 摘要。
IMAGE_DIGEST=
LOG_LEVEL=info
ABV_AUTH_MODE=all_except_health
ABV_MAX_BODY_SIZE=104857600
ABV_HEALTH_WATCHDOG_ENABLED=true
ABV_PROXY_HEALTH_BATCH_SIZE=25
ABV_PROXY_HEALTH_CONCURRENCY=5
ABV_PROXY_HEALTH_START_DELAY_SECS=60
# 升级时保留原宿主数据目录。release 默认 ./data，本地构建默认 ~/.antigravity_tools。
# ABV_HOST_DATA_DIR=/absolute/path/to/existing/data
